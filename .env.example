# Model selection — uses provider/model string format
ASH_MODEL=anthropic/claude-3-7-sonnet-20250219
# For Ollama (no API key needed):
# ASH_MODEL=ollama/qwen2.5-coder:7b

# Per-provider API keys — standard env vars (NOT ASH_-prefixed)
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_BASE=  # optional, for proxies or custom endpoints
OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=  # optional, for OpenAI-compatible providers
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# GROQ_API_KEY=
# GROQ_API_BASE=https://api.groq.com/openai/v1
# OLLAMA_API_BASE=http://localhost:11434

# Backward compat (auto-promoted on startup)
# ASH_API_KEY=sk-ant-...     → promoted to ANTHROPIC_API_KEY
# ASH_MODEL_NAME=claude-...   → promoted to ASH_MODEL (prepends ASH_PROVIDER if set)
# ASH_PROVIDER=anthropic      → used to prefix ASH_MODEL if no '/' present

# Non-provider settings
ASH_TEMPERATURE=0.0
ASH_MAX_CONTEXT_TOKENS=128000
ASH_MAX_COMPLETION_TOKENS=4000
ASH_MAX_TOOL_RESULT_TOKENS=20000
ASH_SAFETY_TIER=interactive
ASH_WORKSPACE_ROOT=.
ASH_COMMAND_BLOCKLIST=["format","rm -rf","Remove-Item"]
ASH_DB_DIRECTORY=~/.ash/db
